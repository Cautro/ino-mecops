# Copy to .env and fill in real values. Never commit the real .env.
BOT_TOKEN=123456789:replace-with-real-bot-token
DATABASE_URL=postgres://inomecops:change-me@localhost:5432/inomecops?sslmode=disable
# Public HTTPS URL of the Mini App. Optional while building only the backend.
WEBAPP_URL=https://game.example.com
# Comma-separated numeric Telegram user IDs allowed to manage promo codes.
ADMIN_TELEGRAM_IDS=123456789
PORT=8080

# Uploaded creature images are stored as files, not generated by frontend code.
UPLOAD_DIR=./uploads
